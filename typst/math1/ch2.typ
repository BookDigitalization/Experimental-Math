#numbered-align(($3\(8 x - 1\)$, $zws = 20 x + 29$, [(原方程两边乘以10)]), ($24 x - 3$, $zws = 20 x + 29$, [(去括号)]), ($24 x - 20 x$, $zws = 29 + 3$, [(移项变号)]), ($4 x$, $zws = 32$, [(合并同类项)]), ($x$, $zws = 8$, [(两边除以4)]));

