// 第五章 因式分解与余式定理 的插图（对应 math1/5.tex 中的 tikzpicture，按出现顺序编号）
#import "../../common/fig.typ": *

// 字符串按公式排（如 "+6"），内容原样排
#let m(t) = if type(t) == str { eval(t, mode: "math") } else { t }
// \boxed
#let bx(x) = box(stroke: 0.4pt, inset: 3pt, baseline: 3pt, x)
// LaTeX 中隔着 \; 等空白的 + − 仍是二元运算符，Typst 需要显式指定
#let bp = math.class("binary", sym.plus)
#let bm = math.class("binary", sym.minus)
// \tfrac：按行内分数的大小排
#let tf(a, b) = text(size: .72em, $display(#a / #b)$)

// 十字相乘法的一次尝试：上排 a b，下排 c d，交叉连线，下面写验算和结论
#let cross(dx, a, b, c, d, check, verdict) = group({
  translate((dx, 0))
  node((-.6, 1.2), m(a), name: "A")
  node((.6, 1.2), m(b), name: "B")
  node((-.6, 0), m(c), name: "C")
  node((.6, 0), m(d), name: "D")
  line("A.south-east", "D.north-west", stroke: 1.2pt)
  line("B.south-west", "C.north-east", stroke: 1.2pt)
  node((0, -.5), check)
  node((0, -1), verdict)
})

// 一组节点：pairs 为 ((x, y), 文字) 列表，统一用 pos 定位
#let nodes(pairs, pos: "left") = for (p, t) in pairs { node(p, m(t), pos: pos) }

// 一列节点：在 x 处，pairs 为 (y, 文字) 列表
#let col(x, pairs, pos: "left") = for (y, t) in pairs { node((x, y), m(t), pos: pos) }

// 短除法求最小公倍数等：两列数，左侧逐级的除数
#let ladder(left, right, divisors) = {
  for (y, t) in left.enumerate() { node((0, y), [#t], pos: "left") }
  for (y, t) in right.enumerate() { node((2, y), [#t], pos: "left") }
  for (y, d) in divisors {
    let x0 = -1 - y * .3
    line((x0, y), (2.5, y))
    line((x0, y), (x0, y + 1), name: "v")
    node("v.mid", [#d], pos: "left")
  }
}

// 辗转相除法（竖式之一）：左列在 x=-1，右列在 x=1，竖线 x=-2.6、-.7、1.2
#let euclid(left, right, ys, labels, le: -1, rs: -.4) = {
  let top = left.len() - 1
  for (y, t) in left.enumerate() { if t != none { node((-1, y), m(t), pos: "left") } }
  for (y, t) in right.enumerate() { node((1, y), m(t), pos: "left") }
  for x in (-2.6, -.7, 1.2) { line((x, -.5), (x, top + .5)) }
  for y in ys {
    line((-2.5, y), (le, y))
    line((rs, y), (1.1, y))
  }
  for (p, t) in labels { node(p, [#t]) }
}

// 辗转相除法（竖式之二）：左列在 x=-.2，右列在 x=1.2，竖线 x=-1.5、0、1.5
#let euclid2(left, right, bottom, hl, hr, ql, qr) = {
  col(-.2, left)
  col(1.2, right)
  for x in (0, -1.5, 1.5) { line((x, bottom), (x, 6.5)) }
  for y in hl { line((-1.3, y), (-.2, y)) }
  for y in hr { line((.2, y), (1.3, y)) }
  for (y, t) in ql { node((-1.6, y), [#t], pos: "left") }
  for (y, t) in qr { node((1.6, y), [#t], pos: "right") }
}

